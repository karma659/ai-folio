<div class="home-portfolio">
  <section class="home-section" id="skills" aria-labelledby="home-skills-title">
    <header class="home-section__header">
      <div>
        <h2 id="home-skills-title">Skills</h2>
        <p class="home-section__summary">The tools and methods I use to build software and research financial markets.</p>
      </div>
    </header>

    <div class="home-skills-grid">
      {% for skill in site.data.skills %}
        <div class="home-skill-group">
          <h3><i class="fa-solid fa-{{ skill.icon }}" aria-hidden="true"></i>{{ skill.title }}</h3>
          <ul class="home-skill-list">
            {% for item in skill.items %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    </div>
  </section>

  <section class="home-section" id="projects" aria-labelledby="home-projects-title">
    <header class="home-section__header">
      <div>
        <h2 id="home-projects-title">Projects</h2>
        <p class="home-section__summary">Selected work in quantitative finance, software, and applied AI.</p>
      </div>
      <a class="home-section__link" href="{{ '/projects/' | relative_url }}">View all projects <span aria-hidden="true">&rarr;</span></a>
    </header>

    {% assign home_projects = site.projects | sort: 'importance' %}
    <div class="home-projects-grid">
      {% for project in home_projects limit: 6 %}
        {% assign project_link = project.url | relative_url %}
        {% if project.redirect %}
          {% assign project_link = project.redirect %}
        {% endif %}
        <article class="home-project-card">
          <a href="{{ project_link }}" aria-label="View {{ project.title | escape }}">
            {% if project.img %}
              <div class="home-project-card__image">
                {%
                  include figure.liquid
                  loading="lazy"
                  path=project.img
                  sizes="(min-width: 992px) 290px, (min-width: 576px) 440px, 95vw"
                  alt=project.title
                %}
              </div>
            {% endif %}
            <div class="home-project-card__body">
              <h3>{{ project.title }}</h3>
              <p>{{ project.description }}</p>
              <span class="home-project-card__action">
                {% if project.redirect contains 'github.com' %}
                  View code
                {% elsif project.redirect contains 'medium.com' %}
                  Read write-up
                {% elsif project.redirect contains 'colab.research.google.com' %}
                  Open notebook
                {% else %}
                  View project
                {% endif %}
                <span aria-hidden="true">&rarr;</span>
              </span>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </section>
</div>
