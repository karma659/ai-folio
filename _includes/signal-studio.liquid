<div class="signal-studio" data-signal-studio>
  <div class="studio-heading"><span><span class="status-dot" aria-hidden="true"></span> Signal studio</span><span class="studio-index">AK / 001</span></div>
  <div class="signal-display">
    <img class="signal-fallback" src="{{ '/assets/img/portfolio/signal.svg' | relative_url }}" alt="An abstract field of connected data points">
    <canvas class="signal-canvas" aria-hidden="true"></canvas>
    <div class="studio-axis" aria-hidden="true"><span>RESEARCH</span><span>ENGINEERING</span></div>
  </div>
  <div class="studio-controls" hidden>
    <div class="studio-modes" role="group" aria-label="Visualization mode">
      <button type="button" data-signal-mode="signal" aria-pressed="true">Signals</button>
      <button type="button" data-signal-mode="regime" aria-pressed="false">Regimes</button>
      <button type="button" data-signal-mode="allocation" aria-pressed="false">Allocation</button>
    </div>
    <button class="motion-toggle" type="button" aria-label="Pause visualization" aria-pressed="false">Pause</button>
  </div>
  <div class="studio-caption"><p class="studio-description" aria-live="polite">Finding structure in a field of signals.</p><span>Illustrative visualization</span></div>
</div>
