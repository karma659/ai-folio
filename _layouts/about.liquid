  </div>
</section>
<section class="portfolio-section about-section" aria-labelledby="about-title">
  <div>
    <p class="eyebrow">01 / The way I work</p>
    <h2 id="about-title">
      Curiosity in.<br>
      Useful systems out.
    </h2>
    <a class="text-link" href="https://github.com/karma659">Find me on GitHub <span aria-hidden="true">↗</span></a>
  </div>
  <div class="about-copy">{{ content }}</div>
</section>
<section class="portfolio-section" aria-labelledby="selected-work-title">
